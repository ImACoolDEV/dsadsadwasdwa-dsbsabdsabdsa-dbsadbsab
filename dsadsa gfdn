local function addBtn(text, cb)
    local b = Instance.new("TextButton", container)
    b.Size = UDim2.new(1, 0, 0, 36)
    b.BackgroundColor3 = Color3.fromRGB(22, 14, 34)
    b.Text = text
    b.TextColor3 = Color3.fromRGB(210, 160, 255)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    local s = Instance.new("UIStroke", b)
    s.Color = Color3.fromRGB(100, 0, 180)
    b.Activated:Connect(function() pcall(cb) end)
    return b
end

local function addToggleUI(text, default, cb)
    local state = default
    local b = Instance.new("TextButton", container)
    b.Size = UDim2.new(1, 0, 0, 36)
    b.BackgroundColor3 = state and Color3.fromRGB(100, 0, 180) or Color3.fromRGB(22, 14, 34)
    b.Text = text .. (state and ": ON" or ": OFF")
    b.TextColor3 = Color3.fromRGB(210, 160, 255)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    local s = Instance.new("UIStroke", b)
    s.Color = Color3.fromRGB(100, 0, 180)
    
    b.Activated:Connect(function()
        state = not state
        b.Text = text .. (state and ": ON" or ": OFF")
        b.BackgroundColor3 = state and Color3.fromRGB(100, 0, 180) or Color3.fromRGB(22, 14, 34)
        cb(state)
    end)
    return b
end

-- 1. Hyper-Fast Multi-Fire Loop
local fastOn = false
addToggleUI("🌀 INSANITY HYPER FAST LOOP", false, function(state)
    fastOn = state
end)

conns.Fast = rs.Heartbeat:Connect(function()
    if fastOn then
        pcall(function()
            local char = lp.Character
            local tool = char and char:FindFirstChildOfClass("Tool") or (lp.Backpack and lp.Backpack:FindFirstChildOfClass("Tool"))
            if tool then
                local remote = tool:FindFirstChild("InflictTarget", true) or rep:FindFirstChild("InflictTarget", true)
                if remote then
                    for _, obj in ipairs(ws:GetChildren()) do
                        if obj:IsA("Model") and obj ~= char then
                            local hum = obj:FindFirstChildOfClass("Humanoid")
                            local part = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head") or obj:FindFirstChildWhichIsA("BasePart")
                            if hum and part and hum.Health > 0 and not plrs:GetPlayerFromCharacter(obj) then
                                -- Multi-fire sub-loop so it fires multiple times per single heartbeat frame
                                for i = 1, 50 do
                                    remote:FireServer(hum, part)
                                end
                            end
                        end
                    end
                end
            end
        end)
    end
end)

