local function addBtn(parentPage, text, cb)
    local b = Instance.new("TextButton", parentPage)
    b.Size = UDim2.new(1, 0, 0, 36)
    b.BackgroundColor3 = Color3.fromRGB(35, 20, 58)
    b.Text = text
    b.TextColor3 = Color3.fromRGB(220, 180, 255)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    b.ZIndex = 14
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    local s = Instance.new("UIStroke", b)
    s.Color = Color3.fromRGB(120, 0, 200)
    b.Activated:Connect(function() pcall(cb) end)
    return b
end

local function addToggleUI(parentPage, text, default, cb)
    local state = default
    local b = Instance.new("TextButton", parentPage)
    b.Size = UDim2.new(1, 0, 0, 36)
    b.BackgroundColor3 = state and Color3.fromRGB(120, 0, 220) or Color3.fromRGB(35, 20, 58)
    b.Text = text .. (state and ": ON" or ": OFF")
    b.TextColor3 = Color3.fromRGB(220, 180, 255)
    b.Font = Enum.Font.GothamBold
    b.TextSize = 12
    b.ZIndex = 14
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    local s = Instance.new("UIStroke", b)
    s.Color = Color3.fromRGB(120, 0, 200)
    
    b.Activated:Connect(function()
        state = not state
        b.Text = text .. (state and ": ON" or ": OFF")
        b.BackgroundColor3 = state and Color3.fromRGB(120, 0, 220) or Color3.fromRGB(35, 20, 58)
        cb(state)
    end)
    return b
end

