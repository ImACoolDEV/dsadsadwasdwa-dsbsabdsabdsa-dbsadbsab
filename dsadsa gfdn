addBtn("💥 FLING RAKOOF", function()
    pcall(function()
        local char = lp.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local rake = nil
        for _, m in pairs(ws:GetDescendants()) do
            if m:IsA("Model") and (m.Name:lower():find("rake") or m.Name:lower():find("rakoof")) then
                if m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Head") or m:FindFirstChildWhichIsA("BasePart") then
                    rake = m
                    break
                end
            end
        end
        if rake then
            local part = rake:FindFirstChild("HumanoidRootPart") or rake:FindFirstChild("Head") or rake:FindFirstChildWhichIsA("BasePart")
            if part then
                local bav = Instance.new("BodyAngularVelocity", hrp)
                bav.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
                bav.AngularVelocity = Vector3.new(0, 99999, 0)
                local orig = hrp.CFrame
                for i = 1, 30 do
                    hrp.CFrame = part.CFrame
                    task.wait(0.01)
                end
                bav:Destroy()
                hrp.CFrame = orig
            end
        end
    end)
end)
